# ─────────────────────────────────────────────────────────────────────────────
# api/.env.example — Template de variables de entorno para GymPro API
#
# USO:
#   cp api/.env.example api/.env
#   # Editar api/.env con tus valores reales (NUNCA commitear api/.env)
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera valores seguros con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a22ae79e113adf97a6c2eae991656b03b771c5a892a43d704e5fd2cea6e8fba8
JWT_SECRET_KEY=52306c68180e39c75335276ac353911a1e0f3b1e68b3ef547454690e3fd1dac3
FLASK_DEBUG=0

# ── MongoDB ───────────────────────────────────────────────────────────────────
# En docker-compose este valor se sobreescribe automáticamente a:
#   MONGO_URI=mongodb://mongo:27017/gymdb
#
# Variantes según entorno:
#   Docker local (sin auth):  mongodb://mongo:27017/gymdb
#   EC2 local (con auth):     mongodb://admin:secreto@mongo:27017/gymdb
#   Atlas (si aplica):        mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/gymdb
MONGO_URI=mongodb://mongo:27017/gymdb
MONGO_DB=gymdb

# ── Redis ─────────────────────────────────────────────────────────────────────
# En docker-compose se sobreescribe a redis://redis:6379/0 automáticamente.
# Este valor aplica solo si corres la API fuera de Docker.
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos.
# Dev:  http://localhost:3000
# Prod: https://tugimnasio.gymsaas.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Email (backups y notificaciones) ─────────────────────────────────────────
# Para Gmail usa una App Password de 16 letras (no tu contraseña real):
#   Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=abcd_efgh_ijkl_mnop
MAIL_DEFAULT_SENDER=tu_email@gmail.com
MAIL_RECIPIENT=tu_email@gmail.com

# ── Spark (analytics — opcional) ──────────────────────────────────────────────
# false → endpoints /api/spark/* retornan 503; el resto de la API sigue normal
# true  → requiere Java 11/17 en el contenedor (incluido en el Dockerfile de api)
SPARK_ENABLED=false

# ── LEGACY — MySQL (deprecado, se elimina en Sprint 2) ────────────────────────
# Vestigio de la versión MySQL original. SQLAlchemy está pendiente de remover.
DB_USER=legacy
DB_PASSWORD=legacy
DB_HOST=localhost
DB_NAME=gymdb
