# ─────────────────────────────────────────────────────────────────────────────
# api/.env.example — Template de variables de entorno para GymPro API
#
# USO:
#   cp api/.env.example api/.env
#   # Editar api/.env con tus valores reales (NUNCA commitear api/.env)
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera valores seguros con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a22ae79e113adf97a6c2eae991656b03b771c5a892a43d704e5fd2cea6e8fba8
JWT_SECRET_KEY=52306c68180e39c75335276ac353911a1e0f3b1e68b3ef547454690e3fd1dac3
FLASK_DEBUG=0

# ── Zona horaria ──────────────────────────────────────────────────────────────
# Zona del gimnasio. Determina con qué fecha y hora se guardan ventas, pagos,
# asistencias y check-ins. Sin ella el contenedor usa UTC y un movimiento de la
# noche queda registrado con la fecha del día siguiente.
# Nombre IANA: America/Mexico_City, America/Bogota, America/Argentina/Buenos_Aires…
APP_TIMEZONE=America/Mexico_City

# ── MongoDB ───────────────────────────────────────────────────────────────────
# En docker-compose este valor se sobreescribe automáticamente a:
#   MONGO_URI=mongodb://mongo:27017/gymdb
#
# Variantes según entorno:
#   Docker local (sin auth):  mongodb://mongo:27017/gymdb
#   EC2 local (con auth):     mongodb://admin:secreto@mongo:27017/gymdb
#   Atlas (si aplica):        mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/gymdb
MONGO_URI=mongodb://mongo:27017/gymdb
MONGO_DB=gymdb

# ── Redis ─────────────────────────────────────────────────────────────────────
# En docker-compose se sobreescribe a redis://redis:6379/0 automáticamente.
# Este valor aplica solo si corres la API fuera de Docker.
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos.
# Dev:  http://localhost:3000
# Prod: https://tugimnasio.gymsaas.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Email (recuperación de contraseña, backups y notificaciones) ─────────────
# Este archivo se sube al repositorio: NO escribas credenciales reales aquí.
# Copia estas claves a api/.env y rellénalas ahí.
#
# Con Gmail, MAIL_PASSWORD NO es la contraseña de la cuenta (Google la rechaza
# desde 2022): es una App Password de 16 letras que se genera en
#   Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
# Se escribe seguida, sin los espacios con que Google la muestra.
#
# Si el envío falla, /auth/forgot-password responde igual que si hubiera
# funcionado (para no revelar qué correos existen). El motivo real queda en:
#   docker compose logs api | grep forgot-password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=correo_del_proyecto@gmail.com
MAIL_PASSWORD=contrasena_de_aplicacion_16_letras
MAIL_DEFAULT_SENDER=correo_del_proyecto@gmail.com
MAIL_RECIPIENT=correo_del_proyecto@gmail.com

# ── Spark (analytics — opcional) ──────────────────────────────────────────────
# false → endpoints /api/spark/* retornan 503; el resto de la API sigue normal
# true  → requiere Java 11/17 en el contenedor (incluido en el Dockerfile de api)
SPARK_ENABLED=false

# ── PostgreSQL (Sprint 2 — plataforma, finanzas, multi-tenant) ───────────────
# En docker-compose este valor se sobreescribe automáticamente con el nombre
# del servicio postgres. Este valor aplica si corres la API fuera de Docker.
#
# Formato: postgresql+psycopg2://user:password@host:port/database
POSTGRES_URI=postgresql+psycopg2://gymuser:gympassword@localhost:5432/gymprodb
POSTGRES_DB=gymprodb
POSTGRES_USER=gymuser
POSTGRES_PASSWORD=gympassword

# ── Pagos en linea: PayPal y Mercado Pago ────────────────────────────────────
# Modelo adoptado: cada gimnasio registra SUS PROPIAS credenciales desde la app
# (Configuracion -> Pagos), de modo que el dinero de membresias y productos cae
# directo en su cuenta. La plataforma no custodia esos fondos.
#
# 1) Clave para cifrar las credenciales que los gimnasios guardan en la BD.
#    OBLIGATORIA para que funcione la pantalla de configuracion de pagos.
#    Generar una propia con:
#      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#    Si se pierde o se cambia, los gimnasios deberan recapturar sus credenciales.
PAYMENTS_ENCRYPTION_KEY=mhsZCFtJFKx5d_cDdaFxfLCw8bSmb4XJWZFWNyawoLM=

# 2) Credenciales DE LA PLATAFORMA. Solo se usan para cobrar la suscripcion SaaS
#    (el gimnasio paga su plan a GymPro). Dejar vacias desactiva ese cobro.
PLATAFORMA_PAYPAL_CLIENT_ID=
PLATAFORMA_PAYPAL_SECRET=
PLATAFORMA_MP_ACCESS_TOKEN=
PLATAFORMA_PAGOS_MODO=sandbox
PLATAFORMA_PAGOS_MONEDA=MXN

# 3) URLs publicas usadas en el checkout.
#    FRONTEND_URL: a donde regresa el pagador tras completar el pago.
#    PUBLIC_API_URL: URL publica de la API para recibir webhooks. En local se
#    deja vacia (los webhooks no llegan a localhost); con ngrok se pone la URL
#    https que entrega el tunel.
FRONTEND_URL=http://localhost:8080
PUBLIC_API_URL=

# ── Migraciones (Alembic) ─────────────────────────────────────────────────────
# Correr desde api/ con Postgres activo:
#   alembic upgrade head              → aplicar todas las migraciones
#   alembic revision --autogenerate -m "descripcion"  → nueva migración
#   docker compose exec api python -m app.seeds.seed_pg  → datos iniciales
