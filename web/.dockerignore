# Dependencias instaladas — se reinstalan dentro del contenedor con npm ci
node_modules/

# Bundle generado por CRA — se regenera en el builder stage
build/

# Variables de entorno locales — se pasan como build args en docker-compose
.env
.env.local
.env.*.local

# Archivos de desarrollo y herramientas locales
.git/
.gitignore

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artifacts
.DS_Store
Thumbs.db

# Tests — no necesarios para el build de producción
src/**/*.test.js
src/**/*.test.jsx
src/**/*.spec.js
src/**/*.spec.jsx
src/setupTests.js
src/reportWebVitals.js
